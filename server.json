{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.ussumant/whiteboard-agents",
  "title": "whiteboard-agents",
  "description": "Comment on a whiteboard, and your coding agent answers on it: a live Excalidraw board.",
  "repository": {
    "url": "https://github.com/ussumant/whiteboard-agents",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "whiteboard-agents",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
